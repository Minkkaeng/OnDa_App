# OnDa App Public Environment Variables Template
# Copy this file to '.env' and fill in your actual private credentials.

# 1. Google Gemini API Key (For AI Daily Care Guide & Poop Analysis Scanner)
# Get a key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Public Data Portal API Key (For Veterinary Clinic & Pharmacy Locator Caching)
# Get a key from: https://www.data.go.kr/ (Encoding/Decoding key)
VITE_PUBLIC_DATA_PORTAL_KEY=YOUR_PUBLIC_DATA_PORTAL_KEY

# 3. Google AdMob Android App ID (For App Monetization)
# Use AdMob test app ID for testing: ca-app-pub-3940256099942544~3347511713
VITE_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
